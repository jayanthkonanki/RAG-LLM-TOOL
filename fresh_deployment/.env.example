# =============================================================
# RAG-LLM-TOOL — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================

# ---------------------------
# PostgreSQL
# ---------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---------------------------
# Backend DB Connection
# Docker: DB_HOST=postgres  |  Local dev: DB_HOST=localhost
# ---------------------------
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---------------------------
# RabbitMQ (Celery broker)
# ---------------------------
RABBITMQ_HOST=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ---------------------------
# Milvus Vector DB
# ---------------------------
MILVUS_URI=
COLLECTION_NAME=
EMBED_DIM=

# ---------------------------
# Ollama (LLM + Embeddings)
# Point to host's local Ollama: http://host.docker.internal:11434
# ---------------------------
OLLAMA_URI=
EMBED_MODEL=
LLM_MODEL=
RAG_TOP_K=

# ---------------------------
# Frontend
# Browser calls this from the user machine — must be localhost
# ---------------------------
NEXT_PUBLIC_API_URL=
