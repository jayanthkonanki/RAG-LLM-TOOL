# =============================================================
# RAG-LLM-TOOL — Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in your actual values.
# .env is gitignored. This file (.env.example) is safe to commit.

# ---------------------------
# PostgreSQL (used by Docker postgres container)
# ---------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=rag_state

# ---------------------------
# Backend DB Connection (used by Python services)
# Docker: DB_HOST=postgres  |  Local dev: DB_HOST=localhost
# ---------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rag_state
DB_USER=postgres
DB_PASSWORD=your_password_here

# ---------------------------
# Frontend
# Browser calls this directly — must be localhost, not docker service name
# ---------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
